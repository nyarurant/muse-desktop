{
  "name": "muse-app",
  "version": "0.4.0",
  "private": true,
  "description": "Muse desktop client with a local conversation UI and direct encrypted gateway connection",
  "main": "src/main.js",
  "author": "Community prototype (not affiliated with Meta)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node scripts/live-check.js",
    "test:ui": "node scripts/ui-check.js",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "dev.community.muse-app",
    "productName": "Muse App",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Muse"
    }
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "ws": "^8.22.0"
  }
}
